#!/usr/bin/env bash
# Template only. A future approved executor may render and run this on a node.
set -euo pipefail

cat >/etc/modules-load.d/kubernetes.conf <<'EOF'
overlay
br_netfilter
EOF
modprobe overlay
modprobe br_netfilter
cat >/etc/sysctl.d/99-kubernetes.conf <<'EOF'
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward = 1
EOF
sysctl --system
swapoff -a
sed -ri '/\sswap\s/s/^/#/' /etc/fstab

# Install and pin kubelet, kubeadm, and kubectl at ${kubernetes_version}.
# Enable kubelet only after installation by the approved automation executor.
